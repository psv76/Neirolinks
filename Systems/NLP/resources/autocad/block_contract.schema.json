{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nl-project-3/autocad/block-contract.schema.json",
  "title": "NL Project 3.0 AutoCAD plan-block contract (authoring target 3.2.0)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_documents",
    "approved_block_names",
    "block_name_pattern",
    "track_id_pattern",
    "track_mount_way_values",
    "attribute_profiles",
    "forbidden_attributes",
    "numeric_attributes",
    "functional_groups",
    "block_families",
    "logical_blocks",
    "load_types",
    "board_rules",
    "av_rules"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_documents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 2
    },
    "approved_block_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "block_name_pattern": {
      "type": "string",
      "minLength": 1
    },
    "track_id_pattern": {
      "type": "string",
      "pattern": "^\\^TRACK"
    },
    "track_mount_way_values": {
      "type": "array",
      "items": {
        "enum": [
          "накладной",
          "встроенный",
          "подвесной"
        ]
      },
      "uniqueItems": true,
      "minItems": 3,
      "maxItems": 3
    },
    "attribute_profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "optional",
          "definition_required"
        ],
        "properties": {
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "definition_required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "forbidden": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "forbidden_attributes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "numeric_attributes": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "DECIMAL",
          "NON_NEGATIVE_DECIMAL",
          "POSITIVE_DECIMAL",
          "POSITIVE_INTEGER"
        ]
      }
    },
    "functional_groups": {
      "type": "object",
      "minProperties": 9,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cable_prefix",
          "layers",
          "device_types"
        ],
        "properties": {
          "cable_prefix": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[1-9]$"
          },
          "layers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "device_types": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "block_families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "names",
          "class",
          "device_type",
          "attribute_profile"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "class": {
            "enum": [
              "MOUNTING",
              "FUNCTIONAL"
            ]
          },
          "device_type": {
            "type": "string"
          },
          "attribute_profile": {
            "type": "string"
          },
          "allowed_groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["POWER", "SWITCHES", "LIGHTING_230V", "LIGHTING_LED", "SENSORS", "VENTILATION", "HEATING", "NETWORK", "BUS", "AV"]
            }
          },
          "bus_kind": {
            "enum": ["RS485", "DALI", "KNX"]
          },
          "load_type_group": {
            "type": "string"
          },
          "cable_link_kind": {
            "enum": [
              "TRACK",
              "CABLE"
            ]
          },
          "bus_link_kind": {
            "enum": [
              "TRACK",
              "CABLE"
            ]
          },
          "derived_phase": {
            "type": "integer"
          },
          "key_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "posts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      }
    },
    "logical_blocks": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "required",
          "optional"
        ],
        "properties": {
          "layer": {
            "type": "string"
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "optional": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "dynamic_if_metadata_available": {
            "type": "boolean"
          },
          "ignored_project_data": {
            "type": "boolean"
          }
        }
      }
    },
    "load_types": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "uniqueItems": true
      }
    },
    "board_rules": {
      "type": "object"
    },
    "av_rules": {
      "type": "object"
    }
  }
}
