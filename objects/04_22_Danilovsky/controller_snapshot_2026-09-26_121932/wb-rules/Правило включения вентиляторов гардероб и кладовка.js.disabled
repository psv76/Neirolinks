// Первый массив: гр.335 включается каждый час круглосуточно на 5 минут.
// Второй массив: гр.328 включается каждый час с 09:00 до 22:00 включительно.
// Включение — в начале часа, выключение — на пятой минуте.

// НАСТРОЙКИ
var SCENARIO_NAME = "hourly_fans";
var RUN_MINUTES = 5;
var DAY_START_HOUR = 9;
var DAY_END_HOUR = 22;

// ПЕРВЫЙ МАССИВ — КРУГЛОСУТОЧНО, ГР.335
var RELAYS_ALL_DAY = [
  "wb-mr6c_138/K5"
];

// ВТОРОЙ МАССИВ — С 09:00 ДО 22:00, ГР.328
var RELAYS_DAYTIME = [
  "wb-mr6c_218/K1"
];

// УПРАВЛЕНИЕ РЕЛЕ
function setRelays(relays, value) {
  relays.forEach(function (topic) {
    if (dev[topic] !== value) {
      dev[topic] = value;
    }
  });
}

// ПРАВИЛА
function registerHourlyRules(key, relays, hours) {
  defineRule(SCENARIO_NAME + "_" + key + "_on", {
    when: cron("0 0 " + hours + " * * *"),
    then: function () {
      setRelays(relays, true);
    }
  });

  defineRule(SCENARIO_NAME + "_" + key + "_off", {
    when: cron("0 " + RUN_MINUTES + " " + hours + " * * *"),
    then: function () {
      setRelays(relays, false);
    }
  });
}

// ЗАПУСК
registerHourlyRules("all_day", RELAYS_ALL_DAY, "*");
registerHourlyRules("daytime", RELAYS_DAYTIME, DAY_START_HOUR + "-" + DAY_END_HOUR);