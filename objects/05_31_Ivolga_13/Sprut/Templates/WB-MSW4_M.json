{
  "name": "WB-MSW4 M",
  "manufacturer": "NEIROLINKS",
  "model": "WB-MSW4_M",
  "modelIds": [
    "/devices/(9[0-9]{2}\\.[0-9]{2}_MSW_M)/controls/Current Motion/meta/type"
  ],
  "services": [
    {
      "type": "MotionSensor",
      "logics": [
        {
          "type": "MotionDetectedFromCurrentMotionLevel"
        }
      ],
      "characteristics": [
        {
          "type": "MotionDetected",
          "data": {
            "SwitchOffDelay": 180
          }
        },
        {
          "type": "C_CurrentMotionLevel",
          "link": [
            {
              "type": "Integer",
              "topicGet": "/devices/(1)/controls/Current Motion",
              "minStep": 10,
              "checkValue": true
            }
          ]
        }
      ]
    }
  ]
}
